<?xml version="1.0" encoding="utf-8"?>
<!--
  Network Security Configuration for FixHomi

  Certificate pinning is NOT used because traffic goes through Cloudflare,
  which rotates certificates automatically. Pinning behind a CDN/proxy
  is an anti-pattern that can brick the app when certs rotate.

  Security is provided by:
  - HTTPS enforced (cleartextTrafficPermitted="false")
  - Cloudflare edge SSL + origin SSL to Render
  - JWT authentication on all API requests
-->
<network-security-config>
    <!-- Enforce HTTPS for all connections in production -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Debug overrides: allow cleartext for local dev servers -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="user" />
            <certificates src="system" />
        </trust-anchors>
    </debug-overrides>

    <!-- Allow cleartext for Metro bundler (localhost) in debug builds -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">10.0.3.2</domain>
    </domain-config>
</network-security-config>
